# Site deployment secret for hosted Runware music generation and editing.
RUNWARE_API_KEY=

# Optional model overrides; both defaults are hosted ACE-Step 1.5 models.
RUNWARE_MODEL=runware:ace-step@v1.5-xl-turbo
RUNWARE_ADVANCED_MODEL=runware:ace-step@v1.5-xl-base

# Local development only. The no-auth Node server binds to 127.0.0.1.
PORT=8787
# MUSIC_DATA_DIR=.data/music
# MUSIC_DEBUG_DIR=.data/workflow-debug
# MUSIC_DEBUG_PORT=8797
