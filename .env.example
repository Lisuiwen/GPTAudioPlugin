# Hosted music generation/editing. Keep this secret in the deployment environment.
RUNWARE_API_KEY=
RUNWARE_MODEL=runware:ace-step@v1.5-xl-turbo
RUNWARE_ADVANCED_MODEL=runware:ace-step@v1.5-xl-base

# Replicate is retained for audio listening/critique only.
REPLICATE_ANALYSIS_MODEL=lucataco/qwen2.5-omni-7b

PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Local Node OAuth only. Sites stores encrypted Replicate listening connections in D1.
# AUTH_DATA_DIR=D:/Workspace/project/GPTAudioPlugin/.data
# MUSIC_DATA_DIR=D:/Workspace/project/GPTAudioPlugin/.data/music
# Optional fixed encryption key; otherwise auth.key lives inside AUTH_DATA_DIR.
# Preserve both auth-store.json and auth.key across restarts.
# AUTH_ENCRYPTION_KEY=
# Local Sites harness stores its separate connection/key/database below:
# MUSIC_DEBUG_DIR=D:/Workspace/project/GPTAudioPlugin-workflow-v08/.data/workflow-debug
# MUSIC_DEBUG_PORT=8797
# Connect Replicate privately in /connect only for listening. Never put credentials in source control.
