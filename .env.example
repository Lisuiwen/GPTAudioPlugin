# Node runtime defaults. Sites uses compiled defaults or per-call model selection.
REPLICATE_MODEL=fishaudio/ace-step-1.5
REPLICATE_VOCAL_MODEL=minimax/music-2.6
REPLICATE_COVER_MODEL=minimax/music-cover
REPLICATE_CONTINUATION_MODEL=meta/musicgen:671ac645ce5e552cc63a54a2bbff63fcf798043055d2dac5fc9e36a837eedcfb
REPLICATE_ANALYSIS_MODEL=lucataco/qwen2.5-omni-7b
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Local Node OAuth only. Sites stores encrypted connections in D1.
# AUTH_DATA_DIR=D:/Workspace/project/GPTAudioPlugin/.data
# MUSIC_DATA_DIR=D:/Workspace/project/GPTAudioPlugin/.data/music
# Optional fixed encryption key; otherwise auth.key lives inside AUTH_DATA_DIR.
# Preserve both auth-store.json and auth.key across restarts.
# AUTH_ENCRYPTION_KEY=
# Local Sites harness stores its separate connection/key/database below:
# MUSIC_DEBUG_DIR=D:/Workspace/project/GPTAudioPlugin-workflow-v07/.data/workflow-debug
# MUSIC_DEBUG_PORT=8797
# Connect Replicate privately in /connect. Never put credentials in source control.
